<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.marmot.qilu.modules.media.mapper.MediaFileMapper">
    <update id="markMediaFilesUsed">
        update media_file
        set status = 1
        where user_uuid = #{currUserUuid}
            and status = 2
            and id in
        <foreach collection="mediaIds" item="mediaId" open="(" separator="," close=")">
            #{mediaId}
        </foreach>
    </update>
</mapper>